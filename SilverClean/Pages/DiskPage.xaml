<UserControl x:Class="SilverClean.Pages.DiskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="Análise de disco"/>
                <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Escolha um disco ou pasta e clique em Analisar para ver o que está ocupando espaço."/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Disco:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DriveBox" Width="260" DisplayMemberPath="Label" VerticalContentAlignment="Center"/>
            <Button Content="Escolher pasta..." Click="PickFolder_Click"/>
            <Button x:Name="ScanBtn" Content="Analisar" Click="Scan_Click" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="CancelBtn" Content="Cancelar" Click="Cancel_Click" IsEnabled="False"/>
            <TextBlock/>
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <ProgressBar x:Name="BusyBar" Visibility="Hidden"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="3" Background="Transparent">
            <TabItem Header="Pastas">
                <DockPanel Margin="0,6,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="UpBtn" Content="⬆ Voltar" Click="Up_Click" IsEnabled="False" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PathText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DataGrid x:Name="FolderGrid" MouseDoubleClick="FolderGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"/>
                            <DataGridTemplateColumn Header="% da pasta" Width="200" SortMemberPath="Percent">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="14"/>
                                            <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Arquivos" Binding="{Binding FilesText}" SortMemberPath="Files" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Maiores arquivos">
                <DataGrid x:Name="FilesGrid" Margin="0,6,0,0" MouseDoubleClick="FilesGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Arquivo" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"/>
                        <DataGridTextColumn Header="Modificado" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Dica: clique duas vezes numa pasta para entrar nela."/>
            <Button Content="Abrir no Explorer" Click="OpenExplorer_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
