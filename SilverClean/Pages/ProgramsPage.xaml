<UserControl x:Class="SilverClean.Pages.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Programas instalados"/>
                <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed"/>
        </DockPanel>

        <DataGrid x:Name="ProgGrid" Grid.Row="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Editor" Binding="{Binding Publisher}" Width="200"/>
                <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="120"/>
                <DataGridTextColumn Header="Instalado em" Binding="{Binding InstallDateText}" SortMemberPath="InstallDate" Width="100"/>
                <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="90"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Scope}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Atualizar" Click="Refresh_Click"/>
            <Button x:Name="UninstallBtn" Content="Desinstalar" Click="Uninstall_Click" Style="{StaticResource PrimaryButton}" MinWidth="120"/>
        </StackPanel>
    </Grid>
</UserControl>
