<UserControl x:Class="SilverClean.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Programas na inicialização"/>
                <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Desativar um item impede que ele abra junto com o Windows, sem apagar nada. É o mesmo ajuste do Gerenciador de Tarefas e pode ser revertido a qualquer momento."/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="StartupGrid" Grid.Row="1" MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="Enabled">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9A3B3B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="*"/>
                <DataGridTextColumn Header="Local" Binding="{Binding Location}" Width="230"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Atualizar" Click="Refresh_Click"/>
            <Button Content="Abrir local do arquivo" Click="OpenLocation_Click"/>
            <Button Content="Ativar" Click="Enable_Click"/>
            <Button Content="Desativar" Click="Disable_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
