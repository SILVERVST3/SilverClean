<UserControl x:Class="SilverClean.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- O que limpar -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="O que limpar" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Padrão" Click="Defaults_Click" MinWidth="70"/>
                    <Button Content="Nenhum" Click="None_Click" MinWidth="70"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="True" Margin="0,0,0,6">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="18,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          ToolTip="{Binding Description}" Margin="0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Resultado -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="SummaryTitle" Style="{StaticResource H1}" Text="Pronto para analisar"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Marque os itens à esquerda e clique em Analisar. Nada é apagado antes da sua confirmação."/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,10,0,6">
                <ProgressBar x:Name="BusyBar" IsIndeterminate="False" Visibility="Hidden"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>

            <DataGrid x:Name="ResultGrid" Grid.Row="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="140"/>
                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Arquivos" Binding="{Binding FilesText}" Width="90"/>
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="100"/>
                    <DataGridTextColumn Header="Observação" Binding="{Binding Note}" Width="230"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelBtn" Content="Cancelar" Click="Cancel_Click" IsEnabled="False"/>
                <Button x:Name="AnalyzeBtn" Content="Analisar" Click="Analyze_Click" MinWidth="120"/>
                <Button x:Name="CleanBtn" Content="Limpar" Click="Clean_Click" MinWidth="120" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
