<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SilverClean</AssemblyName>
    <RootNamespace>SilverClean</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>SilverClean.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>SilverClean</Product>
    <Company>SILVER</Company>
    <Description>Limpeza e otimização do Windows</Description>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Projetos WPF não incluem System.IO automaticamente -->
    <Using Include="System.IO" />
    <Resource Include="SilverClean.ico" />
  </ItemGroup>

</Project>
