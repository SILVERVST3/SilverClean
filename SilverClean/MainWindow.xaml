<Window x:Class="SilverClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:SilverClean.Pages"
        Title="SilverClean" Height="740" Width="1180" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="SilverClean.ico"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border Background="{StaticResource SideBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,22,0,18">
                    <TextBlock Text="SilverClean" FontSize="24" FontWeight="Bold" Margin="20,0,0,0">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#AEB6BF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Limpeza e otimização" Foreground="#9BA3AD" Margin="21,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                    <Button Content="Abrir pasta de logs" Click="OpenLogs_Click" Margin="0" HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="VersionText" Foreground="#7F8790" Margin="2,10,0,0" FontSize="11"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavClean" Style="{StaticResource NavButton}" GroupName="nav" Content="🧹  Limpeza" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" GroupName="nav" Content="🚀  Inicialização" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPrograms" Style="{StaticResource NavButton}" GroupName="nav" Content="📦  Programas" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRegistry" Style="{StaticResource NavButton}" GroupName="nav" Content="🧩  Registro" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDisk" Style="{StaticResource NavButton}" GroupName="nav" Content="💽  Análise de disco" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1" Margin="18">
            <pages:CleanerPage x:Name="PageClean"/>
            <pages:StartupPage x:Name="PageStartup" Visibility="Collapsed"/>
            <pages:ProgramsPage x:Name="PagePrograms" Visibility="Collapsed"/>
            <pages:RegistryPage x:Name="PageRegistry" Visibility="Collapsed"/>
            <pages:DiskPage x:Name="PageDisk" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
